# Maintainer: Kindness <hello@kindness.ai>

pkgname=maitri-fish
pkgver=1.6.0
pkgrel=1
pkgdesc="maitri shell configuration for fish (functions, completions, pure prompt, fish-async-prompt, fzf.fish)"
arch=('any')
url="https://github.com/maitrios/maitri-fish"
license=('MIT')
depends=('fish' 'fish-pure-prompt' 'eza' 'mise' 'zoxide' 'fzf' 'fd' 'bat')
options=('!debug')
install=maitri-fish.install
source=("${pkgname}-${pkgver}.tar.gz::${url}/archive/refs/tags/v${pkgver}.tar.gz"
        "fzf.fish-v10.3.tar.gz::https://github.com/PatrickF1/fzf.fish/archive/refs/tags/v10.3.tar.gz"
        "fish-async-prompt-v1.3.0.tar.gz::https://github.com/acomagu/fish-async-prompt/archive/refs/tags/v1.3.0.tar.gz")
sha256sums=('a7b8aba8362b2cef6814efaed4c40eeaa119755887fd9726f4a031fd4c68c94a'
            'a0d56e974b8d5144c3262dcf87630c8886407d28a2f9e626e46bc18199fe6f97'
            'b6baf0f756b301d13ad3cad065b783d0c4d14aee9f8cc6c1b25b28fb485bc1f6')
package() {
  cd "${srcdir}/${pkgname}-${pkgver}"

  # Install fzf.fish to vendor directories
  install -dm755 "${pkgdir}/usr/share/fish/vendor_conf.d"
  install -dm755 "${pkgdir}/usr/share/fish/vendor_functions.d"
  install -dm755 "${pkgdir}/usr/share/fish/vendor_completions.d"
  cp "${srcdir}/fzf.fish-10.3/conf.d/"*.fish "${pkgdir}/usr/share/fish/vendor_conf.d/"
  cp "${srcdir}/fzf.fish-10.3/functions/"*.fish "${pkgdir}/usr/share/fish/vendor_functions.d/"
  cp "${srcdir}/fzf.fish-10.3/completions/"*.fish "${pkgdir}/usr/share/fish/vendor_completions.d/"

  # Install fish-async-prompt to the vendor conf.d
  cp "${srcdir}/fish-async-prompt-1.3.0/conf.d/"*.fish "${pkgdir}/usr/share/fish/vendor_conf.d/"

  # Install maitri-fish conf.d, functions, and completions.
  # dotglob so leading-dot function names like ....fish are not skipped.
  shopt -s dotglob
  cp conf.d/*.fish "${pkgdir}/usr/share/fish/vendor_conf.d/"
  cp functions/*.fish "${pkgdir}/usr/share/fish/vendor_functions.d/"
  cp completions/*.fish "${pkgdir}/usr/share/fish/vendor_completions.d/"
  shopt -u dotglob

  # Install templates and documentation
  install -dm755 "${pkgdir}/usr/share/${pkgname}"
  cp -r templates LICENSE README.md "${pkgdir}/usr/share/${pkgname}/"
  cp "${srcdir}/fzf.fish-10.3/LICENSE.md" "${pkgdir}/usr/share/${pkgname}/LICENSE.fzf.fish"
  cp "${srcdir}/fzf.fish-10.3/README.md" "${pkgdir}/usr/share/${pkgname}/README.fzf.fish.md"
  cp "${srcdir}/fish-async-prompt-1.3.0/LICENSE.md" "${pkgdir}/usr/share/${pkgname}/LICENSE.fish-async-prompt"
  cp "${srcdir}/fish-async-prompt-1.3.0/README.md" "${pkgdir}/usr/share/${pkgname}/README.fish-async-prompt.md"

  # Install setup script
  install -Dm755 bin/maitri-setup-fish "${pkgdir}/usr/bin/maitri-setup-fish"
}

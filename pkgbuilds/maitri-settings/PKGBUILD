# Maintainer: Kindness <hello@kindness.ai>
# Release versioning convention (do not "fix" this; enforced by scripts/bump-maitri):
#  - Pre-releases use the ATTACHED form pkgver=X.Y.ZrcN — NO separator. pacman's
#    vercmp orders 0.2.0rc1 < 0.2.0rc2 < 0.2.0, but 0.2.0.rc1 and 0.2.0_rc1
#    both sort AFTER 0.2.0 and would strand users on the pre-release.
#  - pkgrel resets to 1 whenever pkgver changes; bump pkgrel alone only to
#    repackage the same source.
#  - epoch is a manual escape hatch decided by a human; tooling never sets it.
#  - _commit is the single source of truth for what gets built. _tag is
#    provenance only (empty when cut from a bare commit). maitri and
#    maitri-settings must always carry identical _tag/_commit/pkgver/sha256sums.
pkgname='maitri-settings'
_tag='v0.2.0'
_commit='ad2f1ffa208b4a13b826fca029acaae2a2810b01'
pkgver=0.2.0
pkgrel=1
pkgdesc='maitri user defaults, /etc/skel content, fonts, plymouth theme, and support helpers'
arch=('x86_64')
url='https://github.com/kindness-ai/maitri'
license=('MIT')
conflicts=('maitri-settings-dev')

# `/etc/default/limine` is intentionally NOT owned by this package. The ISO
# orchestrator generates it at install time from the resolved target boot
# cmdline. We ship a template under /usr/share/maitri/default/limine/ for the
# orchestrator to read.
#
# limine + limine-mkinitcpio-hook + limine-snapper-sync + snapper are NOT in
# depends because this package gets installed into the live ISO env (for
# plymouth / /etc/skel seeding) where there is no ESP and the mkinitcpio hook
# would fail trying to deploy Limine. The target maitri package pulls in the
# full bootloader/snapshot stack; maitri-iso only installs the early Limine
# pieces needed before the runtime package lands.
depends=(
  'bash'
  'curl'
  'gum'
  'hicolor-icon-theme'
  'plymouth'
)

makedepends=(
  'git'
  'imagemagick'
)

# backup=() is pacman's hook for protecting user edits to package-owned files
# on upgrade. Only the paths the package actually installs into /etc qualify.
# The etc-overrides set (faillock.conf, nsswitch.conf, cups-browsed.conf,
# cups-files.conf, plymouthd.conf, /etc/skel/.bashrc) ships at
# /usr/share/maitri/etc-overrides/
# and is cp -f'd by post_install — those paths are unowned by pacman and the
# scriptlet WILL clobber user edits on each upgrade (documented limitation).
backup=(
  'etc/1password/custom_allowed_browsers'
  'etc/docker/daemon.json'
  'etc/gnupg/dirmngr.conf'
  'etc/limine-entry-tool.d/maitri-defaults.conf'
  'etc/limine-entry-tool.d/maitri-uki.conf'
  'etc/mise/conf.d/maitri.toml'
  'etc/mkinitcpio.conf.d/maitri_hooks.conf'
  'etc/mkinitcpio.conf.d/thunderbolt_module.conf'
  'etc/modprobe.d/maitri-usb-autosuspend.conf'
  'etc/NetworkManager/conf.d/maitri-wifi-powersave.conf'
  'etc/sddm.conf.d/10-theme.conf'
  'etc/sddm.conf.d/10-wayland.conf'
  'etc/sudoers.d/maitri-dns'
  'etc/sudoers.d/maitri-passwd-tries'
  'etc/sudoers.d/maitri-theme-browser'
  'etc/sudoers.d/maitri-tzupdate'
  'etc/sysctl.d/90-maitri-file-watchers.conf'
  'etc/sysctl.d/99-maitri-sysctl.conf'
  'etc/systemd/logind.conf.d/10-ignore-power-button.conf'
  'etc/systemd/logind.conf.d/20-inhibit-delay.conf'
  'etc/systemd/oomd.conf.d/10-maitri.conf'
  'etc/systemd/resolved.conf.d/10-disable-multicast.conf'
  'etc/systemd/resolved.conf.d/20-docker-dns.conf'
  'etc/systemd/system.conf.d/10-faster-shutdown.conf'
  'etc/systemd/system.conf.d/20-maitri-nofile.conf'
  'etc/systemd/system/cups-browsed.service.d/10-maitri.conf'
  'etc/systemd/system/docker.service.d/no-block-boot.conf'
  'etc/systemd/system/plocate-updatedb.service.d/ac-only.conf'
  'etc/systemd/system/user@.service.d/10-faster-shutdown.conf'
  'etc/systemd/user.conf.d/20-maitri-nofile.conf'
  'etc/sysusers.d/maitri-cups-browsed.conf'
  'etc/tmpfiles.d/maitri-nopasswd-sudo.conf'
  'etc/tmpfiles.d/maitri-zswap.conf'
)

optdepends=(
  'maitri: Full maitri desktop'
  'inxi: System information for maitri-debug'
)

install='maitri-settings.install'

# Live config files the package can't own outright (the path is owned by an
# upstream Arch package): ship them at /usr/share/maitri/etc-overrides/ and
# cp -f into place from post_install. See maitri-settings.install.
_etc_override_paths=(
  'etc/security/faillock.conf'
  'etc/nsswitch.conf'
  'etc/cups/cups-browsed.conf'
  'etc/cups/cups-files.conf'
  'etc/plymouth/plymouthd.conf'
)

# Source: the pinned release commit; set MAITRI_SRC=/path/to/checkout to
# build from a local source tree instead (maitri dev pkg-test, the ISO's --local-source).
if [[ -n "${MAITRI_SRC:-}" ]]; then
  source=()
  sha256sums=()
else
  source=("maitri::git+https://github.com/kindness-ai/maitri.git#commit=${_commit}")
  sha256sums=('SKIP')
fi

prepare() {
  if [[ -n "${MAITRI_SRC:-}" ]]; then
    rm -rf "$srcdir/maitri"
    mkdir -p "$srcdir/maitri"
    cp -a "${MAITRI_SRC}/." "$srcdir/maitri/"
  fi
}

package() {
  cd "$srcdir/maitri"

  # /etc/skel/.config from config/** — system-wide default user config.
  # Package-owned defaults that live elsewhere in the system belong under
  # default/** or etc/** instead.
  install -d "$pkgdir/etc/skel/.config"
  cp -a config/. "$pkgdir/etc/skel/.config/"

  # Fastfetch reads /etc/fastfetch/config.jsonc when no user config exists.
  install -Dm644 etc/fastfetch/config.jsonc "$pkgdir/etc/fastfetch/config.jsonc"

  # ALSO ship config/** under /usr/share/maitri/config/. Used as the
  # source-of-truth by maitri-refresh-config, maitri-reinstall-configs,
  # and other commands that copy individual files into a running user's
  # ~/.config. /etc/skel only seeds new users; this tree is what existing
  # users re-sync against.
  install -d "$pkgdir/usr/share/maitri/config"
  cp -a config/. "$pkgdir/usr/share/maitri/config/"


  # Package-owned defaults with real system/XDG locations. User config remains
  # higher priority: ~/.config/uwsm/default, ~/.config/uwsm/env.d,
  # ~/.config/environment.d, ~/.config/fontconfig, ~/.config/xdg-terminals.list,
  # ~/.config/mimeapps.list, and ~/.config/systemd/user can all override these.
  install -Dm644 default/uwsm/env.d/10-maitri "$pkgdir/usr/share/uwsm/env.d/10-maitri"
  install -Dm644 default/environment.d/10-maitri-fcitx.conf "$pkgdir/usr/lib/environment.d/10-maitri-fcitx.conf"
  install -Dm644 default/fontconfig/conf.avail/50-maitri.conf "$pkgdir/usr/share/fontconfig/conf.avail/50-maitri.conf"
  install -d "$pkgdir/etc/fonts/conf.d"
  ln -sfn /usr/share/fontconfig/conf.avail/50-maitri.conf "$pkgdir/etc/fonts/conf.d/50-maitri.conf"
  install -Dm644 default/xdg-terminal-exec/hyprland-xdg-terminals.list "$pkgdir/usr/share/xdg-terminal-exec/hyprland-xdg-terminals.list"
  install -Dm644 default/applications/mimeapps.list "$pkgdir/usr/share/applications/mimeapps.list"
  install -Dm644 default/systemd/user/bt-agent.service "$pkgdir/usr/lib/systemd/user/bt-agent.service"
  install -Dm644 default/systemd/user/maitri-sleep-lock.service "$pkgdir/usr/lib/systemd/user/maitri-sleep-lock.service"
  install -Dm644 default/systemd/user/maitri-recover-internal-monitor.service "$pkgdir/usr/lib/systemd/user/maitri-recover-internal-monitor.service"
  install -Dm644 default/systemd/user/maitri-migrate-notify.service "$pkgdir/usr/lib/systemd/user/maitri-migrate-notify.service"
  install -Dm644 default/systemd/user/maitri-tailscale-receive.service "$pkgdir/usr/lib/systemd/user/maitri-tailscale-receive.service"
  install -Dm644 default/systemd/user/maitri-fcitx5.service "$pkgdir/usr/lib/systemd/user/maitri-fcitx5.service"
  install -Dm644 default/systemd/user/maitri-crash-watch.service "$pkgdir/usr/lib/systemd/user/maitri-crash-watch.service"
  # Marks app.slice (and only app.slice) as a systemd-oomd kill candidate, so
  # memory pressure costs one app scope instead of the compositor session.
  # Thresholds live in etc/systemd/oomd.conf.d/10-maitri.conf.
    install -Dm644 default/systemd/user/app.slice.d/10-oomd.conf "$pkgdir/usr/lib/systemd/user/app.slice.d/10-oomd.conf"
    install -Dm644 default/systemd/zram-generator.conf.d/90-maitri.conf "$pkgdir/usr/lib/systemd/zram-generator.conf.d/90-maitri.conf"
  # Older release pins still configure locate through install/config/locate.sh.
  if [[ -f default/systemd/system/plocate-updatedb.service.d/10-maitri.conf ]]; then
    install -Dm644 default/systemd/system/plocate-updatedb.service.d/10-maitri.conf "$pkgdir/usr/lib/systemd/system/plocate-updatedb.service.d/10-maitri.conf"
  fi

  # Same for applications/** — used by maitri-refresh-applications,
  # maitri-install-gaming-*, etc. to copy .desktop files into ~/.local/share.
  install -d "$pkgdir/usr/share/maitri/applications"
  cp -a applications/. "$pkgdir/usr/share/maitri/applications/"
  # Icons are package-owned below in /usr/share/icons/hicolor, not this
  # historical app-local folder.
  rm -rf "$pkgdir/usr/share/maitri/applications/icons"

  # /etc tree (drop-ins the package fully owns + the etc-override files we
  # stage separately below).
  install -d "$pkgdir/etc"
  cp -a etc/. "$pkgdir/etc/"
  # sudoers.d files must be mode 0440 or sudo will refuse them, and the
  # directory must be 0750 to match the Arch sudo package's filesystem
  # convention (otherwise pacman warns about dir-mode drift on every install).
  if [[ -d "$pkgdir/etc/sudoers.d" ]]; then
    chmod 0750 "$pkgdir/etc/sudoers.d"
    chmod 0440 "$pkgdir/etc/sudoers.d"/*
  fi

  # Stage upstream-owned files at /usr/share/maitri/etc-overrides/ instead of
  # owning their live /etc paths directly (which would conflict with pam,
  # filesystem, cups-browsed, plymouth, bash). post_install copies them in.
  install -d "$pkgdir/usr/share/maitri/etc-overrides"
  install -Dm644 default/bashrc \
    "$pkgdir/usr/share/maitri/etc-overrides/dot.bashrc"
  cat >"$pkgdir/usr/share/maitri/etc-overrides/os-release" <<EOF
NAME="maitri"
PRETTY_NAME="maitri"
ID=maitri
ID_LIKE=arch
BUILD_ID="$pkgver"
VERSION_ID="$pkgver"
ANSI_COLOR="38;2;130;170;255"
HOME_URL="https://kindness.ai/"
DOCUMENTATION_URL="https://github.com/kindness-ai/maitri#readme"
SUPPORT_URL="https://github.com/kindness-ai/maitri/issues"
BUG_REPORT_URL="https://github.com/kindness-ai/maitri/issues"
LOGO=maitri
EOF
  for path in "${_etc_override_paths[@]}"; do
    case "$path" in
      'etc/security/faillock.conf')
        mv "$pkgdir/$path" "$pkgdir/usr/share/maitri/etc-overrides/security-faillock.conf" ;;
      'etc/nsswitch.conf')
        mv "$pkgdir/$path" "$pkgdir/usr/share/maitri/etc-overrides/nsswitch.conf" ;;
      'etc/cups/cups-browsed.conf')
        mv "$pkgdir/$path" "$pkgdir/usr/share/maitri/etc-overrides/cups-cups-browsed.conf" ;;
      'etc/cups/cups-files.conf')
        [[ ! -f $pkgdir/$path ]] || mv "$pkgdir/$path" "$pkgdir/usr/share/maitri/etc-overrides/cups-cups-files.conf" ;;
      'etc/plymouth/plymouthd.conf')
        mv "$pkgdir/$path" "$pkgdir/usr/share/maitri/etc-overrides/plymouth-plymouthd.conf" ;;
    esac
  done
  # The directories under /etc we just emptied are upstream-owned; remove our
  # empty placeholders so pacman doesn't complain.
  rmdir "$pkgdir/etc/security" 2>/dev/null || true
  rmdir "$pkgdir/etc/cups" 2>/dev/null || true
  rmdir "$pkgdir/etc/plymouth" 2>/dev/null || true

  # /etc/skel/.local/share/applications from applications/**.
  install -d "$pkgdir/etc/skel/.local/share/applications"
  if compgen -G 'applications/*.desktop' >/dev/null; then
    cp applications/*.desktop "$pkgdir/etc/skel/.local/share/applications/"
  fi
  if [[ -d applications/hidden ]] && compgen -G 'applications/hidden/*.desktop' >/dev/null; then
    cp applications/hidden/*.desktop "$pkgdir/etc/skel/.local/share/applications/"
  fi

  # Package-owned application icons in standard freedesktop hicolor paths.
  # Desktop files and generated webapp/TUI launchers reference these by icon
  # name, so user setup no longer needs to copy static maitri icons into
  # ~/.local/share.
  if [[ -d applications/icons ]] && compgen -G 'applications/icons/*' >/dev/null; then
    install -d "$pkgdir/usr/share/icons/hicolor/256x256/apps"
    install -d "$pkgdir/usr/share/icons/hicolor/48x48/apps"
    for icon in applications/icons/*; do
      [[ -f $icon ]] || continue
      icon_name=$(basename "$icon")
      icon_id=$(printf '%s\n' "${icon_name%.*}" \
        | tr '[:upper:]' '[:lower:]' \
        | sed 's/[^[:alnum:]]\+/-/g; s/^-//; s/-$//')
      case "$icon_name" in
        *.svg)
          install -Dm644 "$icon" "$pkgdir/usr/share/icons/hicolor/scalable/apps/$icon_id.svg"
          ;;
        *)
          magick "$icon" -thumbnail 256x256 -background transparent -gravity center -extent 256x256 \
            "PNG32:$pkgdir/usr/share/icons/hicolor/256x256/apps/$icon_id.png"
          magick "$icon" -thumbnail 48x48 -background transparent -gravity center -extent 48x48 \
            "PNG32:$pkgdir/usr/share/icons/hicolor/48x48/apps/$icon_id.png"
          ;;
      esac
    done
  fi

  # default/** ships to /usr/share/maitri/default/. The Snapper template is
  # additionally installed to /etc/snapper/config-templates/ for the standard
  # Snapper template location; maitri target setup copies the default into the
  # live root config.
  install -d "$pkgdir/usr/share/maitri/default"
  cp -a default/. "$pkgdir/usr/share/maitri/default/"

  # Snapper config template used by the install-time `snapper create-config`.
  install -Dm644 default/snapper/root \
    "$pkgdir/etc/snapper/config-templates/maitri"

  # SDDM theme/session assets. These are static package-owned files; the
  # installer only writes autologin.conf because that embeds the install user.
  install -d -m 0755 "$pkgdir/usr/share/sddm/themes"
  cp -a default/sddm/maitri "$pkgdir/usr/share/sddm/themes/"
  find "$pkgdir/usr/share/sddm/themes/maitri" -type d -exec chmod 0755 {} +
  find "$pkgdir/usr/share/sddm/themes/maitri" -type f -exec chmod 0644 {} +
  install -Dm644 default/sddm/hyprland.lua "$pkgdir/usr/share/sddm/hyprland.lua"
  install -Dm644 default/wayland-sessions/maitri.desktop \
    "$pkgdir/usr/local/share/wayland-sessions/maitri.desktop"

  # Plymouth theme. Files at 0644, dirs at 0755 (the upstream plymouth
  # package's convention for /usr/share/plymouth/themes/*). cp -a inherits
  # the source dir's mode, which is whatever the build host has — chmod
  # explicitly so installs are consistent regardless of build environment.
  install -d -m 0755 "$pkgdir/usr/share/plymouth/themes/maitri"
  cp -a default/plymouth/. "$pkgdir/usr/share/plymouth/themes/maitri/"
  find "$pkgdir/usr/share/plymouth/themes/maitri" -type d -exec chmod 0755 {} +
  find "$pkgdir/usr/share/plymouth/themes/maitri" -type f -exec chmod 0644 {} +

  # System font.
  install -Dm644 default/fonts/maitri/maitri.ttf "$pkgdir/usr/share/fonts/maitri/maitri.ttf"

  # systemd system-sleep hook (lazy-unmounts gvfsd-fuse mounts before
  # suspend/hibernate). The script also ships under /usr/share/maitri/default
  # via the default/** copy above; we additionally install it to the live
  # systemd path so the hook fires.
  install -Dm755 default/systemd/system-sleep/unmount-fuse \
    "$pkgdir/usr/lib/systemd/system-sleep/unmount-fuse"

  # Branding assets (logos, icons).
  install -Dm644 logo.txt "$pkgdir/usr/share/maitri/logo.txt"
  install -Dm644 logo.svg "$pkgdir/usr/share/maitri/logo.svg"
  install -Dm644 icon.txt "$pkgdir/usr/share/maitri/icon.txt"
  install -Dm644 icon.png "$pkgdir/usr/share/maitri/icon.png"

  # Standard icon-theme locations so os-release's LOGO=maitri resolves in
  # desktop/system-info tools that use the freedesktop icon lookup rules.
  install -Dm644 icon.png "$pkgdir/usr/share/pixmaps/maitri.png"
  install -Dm644 icon.png "$pkgdir/usr/share/icons/hicolor/256x256/apps/maitri.png"

  # Seed the user-editable branding files into /etc/skel so fresh users
  # have working defaults for `maitri screensaver` and the About screen
  # from the moment they're created. maitri-reinstall-configs refreshes
  # these from the /usr/share/maitri/ sources for existing users.
  install -Dm644 logo.txt "$pkgdir/etc/skel/.config/maitri/branding/screensaver.txt"
  install -Dm644 icon.txt "$pkgdir/etc/skel/.config/maitri/branding/about.txt"

  # Other static per-user defaults seeded via /etc/skel for new users.
  # maitri-finalize-user no longer copies these into $HOME; existing users
  # resync via maitri-reinstall-configs.
  install -Dm644 default/hypr/toggles/flags.lua \
    "$pkgdir/etc/skel/.local/state/maitri/toggles/hypr/flags.lua"
  install -Dm644 default/nautilus-python/extensions/localsend.py \
    "$pkgdir/etc/skel/.local/share/nautilus-python/extensions/localsend.py"
  install -Dm644 default/nautilus-python/extensions/transcode.py \
    "$pkgdir/etc/skel/.local/share/nautilus-python/extensions/transcode.py"
  # Tensaku asks for an annotation size on first run unless its persisted
  # state already names one; seeding it keeps the first screenshot quiet.
  install -Dm644 default/tensaku/state.toml \
    "$pkgdir/etc/skel/.local/state/tensaku/state.toml"

  # Support binaries needed before the full maitri package is installed
  # (used by ISO/recovery flows).
  install -Dm755 bin/maitri-debug      "$pkgdir/usr/bin/maitri-debug"
  install -Dm755 bin/maitri-debug-idle "$pkgdir/usr/bin/maitri-debug-idle"
}

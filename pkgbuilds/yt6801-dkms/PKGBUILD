# Maintainer: Kindness <c@k7.dev>
# Contributor: Shiina Rikka <rikka@rikka.im>

_pkgbase=yt6801
pkgname=yt6801-dkms
pkgver=1.0.34
pkgrel=2
pkgdesc="Kernel module for Motorcomm YT6801 ethernet controller (DKMS)"
arch=('x86_64')
url="https://www.motor-comm.com/product/ethernet-control-chip"
license=('GPL-2.0-or-later')
depends=('dkms')
# The vendor download is a zip containing yt_nic_install.sh and the real source
# tarball (yt6801-<pkgver>.tar.gz, sources at its root). makepkg auto-extracts the
# zip; prepare() unpacks the inner tarball into src/ and applies the kernel-compat patch.
# id=1817 is the vendor's rolling "current Linux driver" link, not a per-version URL:
# when Motorcomm ships a new release the same URL starts serving it and the checksum
# below stops matching. Re-download, compare the inner tarball name, then bump pkgver
# and repin.
source=(${_pkgbase}-${pkgver}.zip::'https://www.motor-comm.com/Cn/Skippower/downloadFile.html?id=1817'
        'patch.diff')
sha256sums=('877e6953fc6eb47232a74e47b0daf33de0e7f9e9a395d3bc10d500d3c4150af8'
            '3bad74e58b248d28212f9af468c0522440b9b96a335930f97595cd9f1a5c7b25')

prepare() {
  cd "${srcdir}"
  rm -rf src && mkdir src
  tar -zxf "${_pkgbase}-${pkgver}.tar.gz" -C src
  # --fuzz=0: a hunk that no longer applies exactly means the vendor moved the
  # code, and a fuzzy match would silently leave the private ioctl interface in.
  patch --fuzz=0 -p1 < patch.diff
  rm -- src/fuxi-gmac-ioctl.c
}

# The vendor ships a private ioctl channel (cmd 0x89F0-0x89FF) into the driver
# that nothing here uses. patch.diff removes its entry points and drops the
# object from the build; fail the build rather than ship it if any of that
# stops applying.
check() {
  local result file pattern
  [[ ! -e $srcdir/src/fuxi-gmac-ioctl.c ]] || return 1
  # A missing or unreadable input is a failed verification, not proof that the
  # private interface is absent. grep returns 1 only for a successful no-match.
  for file in fuxi-gmac-net.c Makefile; do
    [[ -f $srcdir/src/$file && -r $srcdir/src/$file ]] || return 1
    if [[ $file == "Makefile" ]]; then
      pattern='fuxi-gmac-ioctl\.o'
    else
      pattern='\.ndo_(do_ioctl|siocdevprivate)'
    fi
    if grep -E "$pattern" "$srcdir/src/$file" >/dev/null; then
      return 1
    else
      result=$?
      (( result == 1 )) || return 1
    fi
  done
}

package() {
  install -dm755 "${pkgdir}/usr/src/${_pkgbase}-${pkgver}"
  install -m644 "${srcdir}"/src/*.c       "${pkgdir}/usr/src/${_pkgbase}-${pkgver}/"
  install -m644 "${srcdir}"/src/*.h       "${pkgdir}/usr/src/${_pkgbase}-${pkgver}/"
  install -m644 "${srcdir}/src/Makefile"  "${pkgdir}/usr/src/${_pkgbase}-${pkgver}/"
  install -m644 "${srcdir}/src/dkms.conf" "${pkgdir}/usr/src/${_pkgbase}-${pkgver}/"
  install -m644 "${srcdir}/src/motorcomm" "${pkgdir}/usr/src/${_pkgbase}-${pkgver}/"
}
